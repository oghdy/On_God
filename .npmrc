# pnpm 링커 설정 — 근거와 트레이드오프는 docs/decisions/0006-pnpm-isolated-public-hoist.md
# (ADR-0005의 node-linker=hoisted를 대체함).
#
# 기본(isolated) 링커를 그대로 쓰되, 모든 패키지를 루트 node_modules에도 공개 호이스팅한다.
#   - isolated 유지: 각 패키지가 자기 peer 조합에 맞는 의존성만 보게 되므로, React 18(mobile)과
#     React 19(admin)이 한 저장소에 공존해도 next/react-native가 각각 올바른 React를 잡는다.
#     (hoisted 링커에서는 루트에 React가 하나만 존재할 수 있어 한쪽이 반드시 깨졌다.)
#   - shamefully-hoist: Expo/Metro가 metro/src/lib/TerminalReporter, @babel/runtime/helpers/*
#     같은 깊은 transitive 경로를 apps/mobile 기준으로 직접 require()하는 문제(ADR-0005의
#     원래 동기)를 루트 호이스팅으로 해결한다.
shamefully-hoist=true
