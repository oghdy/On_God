# 이 파일을 복사해서 .env.local로 만들고 실제 값을 채운다. .env.local은 git에 커밋되지 않는다.
# 값은 루트 .env의 SUPABASE_DEV_*(로컬 개발) 또는 SUPABASE_PROD_*(Vercel Production)에서 가져온다.
# 자세한 배치 규칙은 docs/secrets-policy.md 참고.

# --- Supabase (클라이언트에도 노출됨 — NEXT_PUBLIC_ 접두사) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (서버 전용 — 절대 NEXT_PUBLIC_ 접두사 붙이지 말 것) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- 운영자 allowlist (콤마로 구분, ADR-0001) ---
ADMIN_EMAILS=
