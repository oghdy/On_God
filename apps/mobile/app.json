{
  "expo": {
    "name": "OnGod",
    "slug": "ongod",
    "version": "0.0.1",
    "scheme": "ongod",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ongod.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "music",
          "spotify",
          "youtube"
        ]
      }
    },
    "android": {
      "package": "com.ongod.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fc8decb2-0d58-4b4b-aa8b-5ba1999d5620"
      }
    },
    "owner": "doyis"
  }
}
